---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

/**
 * Partner logo strip (BRIEF.md §5) — a single horizontal run at the foot of
 * the home page, greyscale at rest and colour on hover.
 *
 * Only partners that actually have a logo file appear in the strip; the count
 * still awaiting a file is reported underneath rather than drawn as empty
 * frames, so the strip reads as a finished row instead of a gap-toothed one.
 *
 * Several logos here are interim, recovered from the 2019/2020 annual report
 * and therefore low resolution. `width` is capped at each file's own natural
 * width so none of them is ever scaled up — a small logo stays small rather
 * than going soft. Replacing the file is the whole fix; nothing here changes.
 */
const all = (await getCollection('partners')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

const withLogo = all.filter((p) => p.data.logo);
const awaiting = all.length - withLogo.length;

/**
 * Optical sizing. Capping every logo at one height makes portrait marks read
 * far smaller than wide ones (a 310x400 mark ends up 37px wide next to a
 * 134px wordmark). Bucket by aspect ratio and give each shape its own cap so
 * the marks carry roughly equal visual weight.
 */
const shapeOf = (logo: { width: number; height: number }) => {
  const aspect = logo.width / logo.height;
  if (aspect >= 2) return 'wide';
  if (aspect >= 0.85) return 'square';
  return 'tall';
};

/** 260px covers a ~130px slot at 2x — but never beyond the file's own width. */
const emitWidth = (logo: { width: number }) => Math.min(260, logo.width);
---

<div class="partners__scroll" tabindex="0" role="group" aria-label="Partner and donor logos">
  <ul class="partners">
    {
      withLogo.map((partner) => (
        <li class="partners__slot" data-shape={shapeOf(partner.data.logo!)}>
          {partner.data.logo!.format === 'svg' ? (
            // SVG passes through untouched — nothing to optimise.
            <img
              src={partner.data.logo!.src}
              width={partner.data.logo!.width}
              height={partner.data.logo!.height}
              alt={partner.data.name}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Image
              src={partner.data.logo!}
              alt={partner.data.name}
              width={emitWidth(partner.data.logo!)}
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
            />
          )}
        </li>
      ))
    }
  </ul>
</div>

{
  awaiting > 0 && (
    <p class="partners__status mono" data-pending>
      ▶ [{awaiting} PARTNER LOGO FILES — awaiting client] Those partners are
      listed on the partners page; they join this strip as each file arrives.
    </p>
  )
}

<style>
  /* One horizontal run. Too many logos to fit at any width, so the strip
     scrolls inside its own box and the page never scrolls sideways. */
  .partners__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    padding-bottom: var(--space-2xs);
  }

  .partners__scroll:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .partners {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-2xs);
    width: max-content;
  }

  .partners__slot {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    inline-size: 8.5rem;
    min-height: 5.5rem;
    padding: var(--space-2xs) var(--space-xs);
    border: var(--hairline);
    scroll-snap-align: start;

    /*
      A white field, not the page green. Several supplied logos are opaque
      JPEGs carrying their own white background — on a green ground they would
      read as white rectangles of slightly different sizes. White makes the
      opaque and the transparent files sit identically.
    */
    background: #ffffff;
    /* Greyscale at rest, colour on hover — on the frame, so it works for any
       logo file without per-logo styling. */
    filter: grayscale(1);
    opacity: 0.9;
    transition: filter var(--dur-fast) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }

  .partners__slot:hover,
  .partners__slot:focus-within {
    filter: grayscale(0);
    opacity: 1;
  }

  .partners__slot :global(img) {
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Per-shape height caps — see shapeOf() above. */
  .partners__slot[data-shape='wide'] :global(img) {
    max-height: 2.4rem;
  }

  .partners__slot[data-shape='square'] :global(img) {
    max-height: 3.1rem;
  }

  .partners__slot[data-shape='tall'] :global(img) {
    max-height: 4rem;
  }

  .partners__status {
    margin-top: var(--space-s);
    font-size: var(--step--2);
    color: var(--navy);
    max-width: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .partners__scroll {
      scroll-snap-type: none;
    }

    .partners__slot {
      transition: none;
    }
  }
</style>
