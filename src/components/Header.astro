---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { NAV } from '../config';
import { path, routePath } from '../lib/url';

/**
 * Site header: dark green band, sticky on every page.
 *
 * The Donate call to action was removed from here at the client's request —
 * donation is carried by the band at the foot of each page instead.
 *
 * The Projects item is a disclosure listing the current projects. It opens on
 * hover and on focus-within, so it works with no JavaScript at all; script
 * only adds click-to-open and Escape-to-close for touch and mouse users.
 */

// Current projects only — the dropdown is a shortcut to live work, not an
// archive. The full list stays one click away on /projects/.
const current = (await getCollection('projects'))
  .filter((p) => p.data.status === 'active')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const here = routePath(Astro.url.pathname);
---

<header class="site-header on-brand">
  <div class="container site-header__inner">
    <a href={path('/')} class="site-header__logo" aria-label="APSEDEC — home">
      <Logo variant="onDark" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__label">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          NAV.map((item) =>
            item.href === '/projects/' ? (
              <li class="site-nav__item site-nav__item--has-menu" data-menu>
                <div class="site-nav__row">
                  <a
                    href={path(item.href)}
                    class="site-nav__link"
                    aria-current={here.startsWith('/projects/') ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class="site-nav__disclosure"
                    aria-expanded="false"
                    aria-controls="projects-menu"
                    data-disclosure
                  >
                    <span class="visually-hidden">Current projects</span>
                    <svg viewBox="0 0 10 6" aria-hidden="true" focusable="false">
                      <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </button>
                </div>

                <ul id="projects-menu" class="site-nav__menu">
                  <li class="site-nav__menu-label label">Current projects</li>
                  {current.map((p) => (
                    <li>
                      <a href={path(`/projects/${p.id}/`)} class="site-nav__menu-link">
                        {p.data.title}
                      </a>
                    </li>
                  ))}
                  <li>
                    <a href={path('/projects/')} class="site-nav__menu-link site-nav__menu-all">
                      All projects, 1999 to today →
                    </a>
                  </li>
                </ul>
              </li>
            ) : (
              <li class="site-nav__item">
                <a
                  href={path(item.href)}
                  class="site-nav__link"
                  aria-current={here === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    /* A step darker than the hero and the page headers below it, so the band
       reads as a layer above the page rather than sharing their ground. */
    background: var(--green-950);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 4.5rem;
    padding-block: var(--space-2xs);
  }

  .site-header__logo {
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-header__logo:hover {
    background: transparent;
  }

  /* --- Nav --------------------------------------------------------------- */
  .site-nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 0.1rem + 0.8vw, 1.2rem);
  }

  .site-nav__item {
    position: relative;
  }

  .site-nav__row {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .site-nav__link {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: #ffffff;
    padding-block: 0.35em;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current='page'] {
    background: transparent;
    color: var(--gold);
    border-bottom-color: rgb(255 255 255 / 65%);
  }

  /* --- Projects disclosure ------------------------------------------------ */
  .site-nav__disclosure {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    color: #ffffff;
    padding: 0.35em 0.15em;
    cursor: pointer;
    min-height: 44px;
  }

  .site-nav__disclosure svg {
    width: 10px;
    height: 6px;
    transition: transform var(--motion, 160ms) ease;
  }

  .site-nav__disclosure:hover {
    color: var(--gold);
  }

  .site-nav__menu {
    display: none;
    position: absolute;
    top: 100%;
    inset-inline-start: 0;
    min-width: 22rem;
    background: var(--green-900);
    border: 1px solid var(--rule-on-green);
    list-style: none;
    margin: 0;
    padding: var(--space-2xs) 0 var(--space-3xs);
  }

  /* No script needed: hover for pointers, focus-within for keyboards. */
  .site-nav__item--has-menu:hover .site-nav__menu,
  .site-nav__item--has-menu:focus-within .site-nav__menu,
  .site-nav__item--has-menu [data-disclosure][aria-expanded='true'] ~ .site-nav__menu {
    display: block;
  }

  .site-nav__item--has-menu:hover .site-nav__disclosure svg,
  .site-nav__item--has-menu:focus-within .site-nav__disclosure svg {
    transform: rotate(180deg);
  }

  .site-nav__menu-label {
    padding: var(--space-3xs) var(--space-s) var(--space-3xs);
    color: var(--green-200);
  }

  .site-nav__menu-link {
    display: block;
    padding: 0.55em var(--space-s);
    color: #ffffff;
    font-size: var(--step--1);
    text-decoration: none;
    line-height: var(--leading-snug);
  }

  .site-nav__menu-link:hover {
    background: var(--green-800);
    color: var(--gold);
  }

  .site-nav__menu-all {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--green-200);
    border-top: 1px solid var(--rule-on-green);
    margin-top: var(--space-3xs);
    padding-top: 0.7em;
  }

  /* --- Mobile ------------------------------------------------------------ */
  .nav-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--rule-on-green);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    padding: 0.5em 0.9em;
    min-height: 44px;
    cursor: pointer;
  }

  @media (max-width: 63.999rem) {
    .nav-toggle {
      display: block;
    }

    .site-nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background: var(--green-900);
      border-block: 1px solid var(--rule-on-green);
      padding: var(--space-s) var(--gutter) var(--space-m);
      max-height: calc(100dvh - 4.5rem);
      overflow-y: auto;
    }

    .site-nav[data-open] {
      display: block;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav__item {
      border-bottom: 1px solid var(--rule-on-green);
    }

    .site-nav__link {
      display: block;
      font-size: var(--step-0);
      padding-block: 0.75em;
      border-bottom: 0;
    }

    /* Stacked nav has room: the project list is simply nested, always open,
       so there is no disclosure to operate on a touch screen. */
    .site-nav__disclosure {
      display: none;
    }

    .site-nav__menu {
      display: block;
      position: static;
      min-width: 0;
      border: 0;
      padding: 0 0 var(--space-2xs) var(--space-s);
    }

    .site-nav__menu-link {
      padding-inline: 0;
    }

    .site-nav__menu-link:hover {
      background: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__disclosure svg {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  // Click-to-open for the Projects menu. CSS already handles hover and
  // focus-within, so this only adds a deliberate tap/click affordance.
  const disclosure = document.querySelector<HTMLButtonElement>('[data-disclosure]');
  const item = disclosure?.closest<HTMLElement>('[data-menu]');

  if (disclosure && item) {
    const setMenu = (open: boolean) => disclosure.setAttribute('aria-expanded', String(open));

    disclosure.addEventListener('click', () => {
      setMenu(disclosure.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (disclosure.getAttribute('aria-expanded') !== 'true') return;
      setMenu(false);
      disclosure.focus();
    });

    document.addEventListener('click', (event) => {
      if (!item.contains(event.target as Node)) setMenu(false);
    });
  }
</script>
