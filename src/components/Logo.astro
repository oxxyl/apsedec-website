---
import { Image } from 'astro:assets';
import logo from '../assets/brand/apsedec-logo-colour.png';

/**
 * APSEDEC logo lockup: the emblem beside the organisation's name.
 *
 * The supplied artwork is a detailed seal — two banners of curved text, a
 * Uganda silhouette and a three-scene roundel. At header size the curved
 * banner text is not legible, so the emblem carries recognition and the
 * typeset name carries the reading. That is the standard treatment for a seal
 * of this kind, and it is why the wordmark is set rather than cropped from the
 * artwork.
 *
 * Source is a raster PNG (2209×2080), so it is never rendered above its native
 * size and is emitted as webp at 2× the display box.
 * ▶ Awaiting: logo source vector, SVG/AI/EPS (PENDING_INPUTS.md).
 *
 * variant="onDark" is the dark-green header and footer: full-colour emblem,
 * white type. The client confirmed the full-colour emblem — not a mono
 * version — is the one to use on the dark band.
 */
interface Props {
  variant?: 'primary' | 'onDark';
  size?: 'sm' | 'md';
}

const { variant = 'primary', size = 'sm' } = Astro.props;
const box = size === 'md' ? 128 : 96;
---

<span class:list={['logo', `logo--${variant}`, `logo--${size}`]}>
  <Image
    class="logo__emblem"
    src={logo}
    alt=""
    width={box}
    height={box}
    densities={[1, 2]}
    format="webp"
    quality={88}
    loading="eager"
  />
  <span class="logo__type">
    <span class="logo__mark">APSEDEC</span>
    <span class="logo__rule" aria-hidden="true"></span>
    <span class="logo__sub">Acholi Private Sector Development Company Ltd</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
    line-height: 1;
  }

  /* .logo__emblem is sized in base.css — it is rendered by <Image>, so a
     scoped rule here never reaches it. */

  .logo__type {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15em;
  }

  .logo__mark {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.02em;
    font-size: var(--step-1);
  }

  .logo--md .logo__mark {
    font-size: var(--step-2);
  }

  .logo__rule {
    display: block;
    height: 1px;
    background: var(--navy);
  }

  .logo__sub {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .logo--md .logo__sub {
    font-size: 0.58rem;
  }

  .logo--primary .logo__mark {
    color: var(--green-700);
  }

  /* Dark green ground: type reverses to white, the rule to translucent white
     (a navy hairline is invisible on --green-900). */
  .logo--onDark .logo__mark,
  .logo--onDark .logo__sub {
    color: #ffffff;
  }

  .logo--onDark .logo__rule {
    background: rgb(255 255 255 / 55%);
  }

  @media (max-width: 30rem) {
    .logo__sub {
      display: none;
    }
  }
</style>
