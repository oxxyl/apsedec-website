---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Assistant from '../components/Assistant.astro';
import { SITE } from '../config';
import { path, routePath, absolute } from '../lib/url';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  /** Receipt page (§8.2) and other non-indexable routes. */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  noindex = false,
} = Astro.props;

const pageTitle = title === SITE.name ? `${SITE.name} — ${SITE.legalName}` : `${title} — ${SITE.name}`;
const canonical = absolute(routePath(Astro.url.pathname), Astro.site ?? SITE.url);
---

<!doctype html>
<html lang="en-UG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={absolute('/og/apsedec.png', Astro.site ?? SITE.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.legalName}`} />
    <meta property="og:locale" content="en_UG" />

    <meta name="theme-color" content="#0c3a20" />

    {/* Generated from the APSEDEC seal. At 32px the banner text is illegible —
        a simplified mark would serve the tab better (PENDING_INPUTS.md). */}
    <link rel="icon" type="image/png" sizes="32x32" href={path('/icons/icon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={path('/icons/icon-180.png')} />

    {/* Critical faces only — the other three swap in when used. */}
    <link
      rel="preload"
      href={path('/fonts/carlito-400.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={path('/fonts/zillaslab-600.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={path('/fonts/plexmono-400.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Assistant />
  </body>
</html>
