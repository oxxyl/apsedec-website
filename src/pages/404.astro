---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { NAV } from '../config';
---

<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <PageHeader
    title="That page does not exist"
    eyebrow="§ 404"
    lede="The address may have changed, or the link that brought you here may be out of date."
  />

  <section class="section">
    <div class="container spread">
      <div class="spread__margin">
        <span>§ 01</span>
        <span>Try</span>
      </div>
      <div>
        <ul class="nf__list ledger">
          {
            NAV.map((item) => (
              <li class="ledger__row nf__row">
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nf__row {
    grid-template-columns: 1fr;
  }

  .nf__row a {
    font-size: var(--step-1);
  }
</style>
